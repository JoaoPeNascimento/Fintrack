# Copie para .env (raiz) antes de rodar `docker compose up`.

# Segredo compartilhado front <-> backend, mín. 32 caracteres (openssl rand -base64 48)
BACKEND_JWT_SECRET=

# NextAuth / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Porta do backend no host (opcional, padrão 8080)
# BACKEND_PORT=8080
